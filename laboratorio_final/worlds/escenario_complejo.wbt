WorldInfo {
  info [
    "Escenario Complejo - Proyecto Final Robotica"
    "Robot debe navegar desde punto INICIO (rojo, celda 0,0) hasta META (verde, celda 11,11)"
    "Grilla de ocupacion: 12x12 celdas de 0.25 x 0.25 m, area total 3.0 x 3.0 m"
    "x(col) = -1.5 + 0.25*col + 0.125 ; y(row) = -1.5 + 0.25*row + 0.125"
    "Conectividad verificada por BFS: existe camino libre entre INICIO y META"
    "Mapa (fila 11 arriba .. fila 0 abajo, columna 0 izq .. 11 der):"
    "row11: . . . . # . . . . . # G"
    "row10: . # . . . . . . . # . #"
    "row9 : . # . . . . . . # # . ."
    "row8 : . # . . # . . # . . . ."
    "row7 : . # . . # . . # . . . ."
    "row6 : . # . . # . . . # . . ."
    "row5 : . . . # # . . # . . . ."
    "row4 : . # . # # # . # # . . #"
    "row3 : . . . . # . . . # . . ."
    "row2 : . # # . . . . . . . . ."
    "row1 : . # . . . . . . . # . ."
    "row0 : S . # . . # # . # . # ."
  ]
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "epuck_wheel"
      material2 "floor"
      coulombFriction [
        0.7
      ]
    }
  ]
}
